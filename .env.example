# ============================================================
# Nyaaya.ai — Configuration Template
#
# Usage:
#   cp .env.example .env
#   Fill in YOUR credentials below
#   NEVER commit .env to git!
# ============================================================

# ------------------------------------------------------------
# AWS Region
# us-east-1 is recommended (cheapest Bedrock pricing)
# ------------------------------------------------------------
AWS_REGION=us-east-1

# ------------------------------------------------------------
# AWS IAM Credentials
# Create an IAM user with these permissions:
#   - bedrock:InvokeModel
#   - dynamodb:GetItem, PutItem, UpdateItem, Query, Scan
#
# Format: AKIA...
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_HERE

# Format: long random string
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY_HERE

# ------------------------------------------------------------
# Bedrock Model
# Don't change — Claude 3.5 Sonnet is the most cost-effective
# ------------------------------------------------------------
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022

# ------------------------------------------------------------
# DynamoDB Table
# Create with: aws dynamodb create-table --table-name nyaaya_interviews ...
# ------------------------------------------------------------
DYNAMODB_TABLE_NAME=nyaaya_interviews

# ------------------------------------------------------------
# Demo / Fallback Mode
#
# DEMO_MODE=true   → Never touches AWS. Uses smart mock Bedrock
#                    and in-memory DynamoDB. Perfect for demos
#                    before AWS credentials arrive.
#
# DEMO_MODE=false  → Respects USE_REAL_BEDROCK / USE_REAL_DYNAMODB
#                    flags below (production mode).
#
# ⬇️  For prototype demo (no AWS credentials yet):
# ------------------------------------------------------------
DEMO_MODE=false

# Set to true to attempt real AWS Bedrock calls
# (Falls back to enhanced mock if call fails)
USE_REAL_BEDROCK=true

# Set to true to attempt real AWS DynamoDB calls
USE_REAL_DYNAMODB=true

# Automatically fall back to smart mock if AWS is unavailable
# (Highly recommended — keeps the demo perfect even if AWS hiccups)
USE_MOCK_FALLBACK=true

# ------------------------------------------------------------
# Environment
# local | dev | prod
# ------------------------------------------------------------
ENV=prod

# ============================================================
# Quick-start recipes:
#
# 1. Demo mode (before AWS credentials — TODAY):
#    DEMO_MODE=true
#    python -m uvicorn main:app --reload --port 8000
#
# 2. Production mode (after AWS credentials — TOMORROW):
#    DEMO_MODE=false
#    USE_REAL_BEDROCK=true
#    USE_REAL_DYNAMODB=true
#    python -m uvicorn main:app --reload --port 8000
#
# 3. Hybrid (try real AWS, fall back to mock on failure):
#    DEMO_MODE=false
#    USE_REAL_BEDROCK=true
#    USE_REAL_DYNAMODB=true
#    USE_MOCK_FALLBACK=true
#    python -m uvicorn main:app --reload --port 8000
# ============================================================
